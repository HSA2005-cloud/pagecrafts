# --- platform (Adithya) ---
SECRET_MASTER_KEY=base64-32-byte-key

# --- publish / hosting (Adhyay, R3) ---
HOSTING_PROVIDER=cloudflare
HOSTING_API_BASE=https://api.cloudflare.com/client/v4
HOSTING_ACCOUNT_ID=replace_me
HOSTING_CREDENTIAL_KEY_ID=cf-deploy-key-2026-01
HOSTING_DEPLOY_CREDENTIAL=iv.tag.ciphertext
PAGECRAFT_ROOT_DOMAIN=pagecrafts.in

# --- app ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- supabase (Adithya) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- ai / providers ---
# Tried left to right. A provider with no API key is skipped. A typo that leaves
# no known provider is a startup error, not a silent default.
# Production is Groq-only on the free Developer tier. Gemini billing is not a
# gate and Gemini is not in this order. Cerebras stays out (unfunded, 402).
# (To serve fixtures instead of any provider, set LLM_MOCK=1 — never in production.)
AI_PROVIDER_ORDER=groq

# Per-operation output-token ceilings (FR-103), shared across providers.
AI_OUTPUT_CLASSIFY_TOKENS=1024
AI_OUTPUT_GENERATE_TOKENS=4000
AI_OUTPUT_EDIT_TOKENS=2000

# --- ai / groq (first priority) ---
# Verify model names and free-tier limits against Groq's live catalogue at key setup.
# Structured output needs a model that supports strict json_schema — the gpt-oss
# models do, the llama-3.x ones do not (the gateway degrades to json_object).
GROQ_API_KEY=your-groq-api-key
# Extra orgs (up to eight Groq organisations: GROQ_API_KEY + GROQ_API_KEY_2..8).
# Round-robined with GROQ_API_KEY. A 429 on one key rotates to the next instead
# of waiting. Daily-cap 429s skip that org for the rest of the process.
# GROQ_API_KEYS=key-org-2,key-org-3
# GROQ_API_KEY_2=
# GROQ_API_KEY_3=
# GROQ_API_KEY_4=
# GROQ_API_KEY_5=
# GROQ_API_KEY_6=
# GROQ_API_KEY_7=
# GROQ_API_KEY_8=
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_STRONG=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Published free-tier limits (console.groq.com/docs/rate-limits). TPD binds before
# RPD: one full generation is ~9.4k tokens, so ~18/day, and it exceeds TPM alone.
GROQ_RPM=30
GROQ_RPD=1000
GROQ_TPM=8000
GROQ_TPD=200000
GROQ_MAX_REQUEST_TOKENS=8000
GROQ_PRICE_IN_PER_MTOK_CENTS=0
GROQ_PRICE_OUT_PER_MTOK_CENTS=0

# --- ai / cerebras (supported, currently out of AI_PROVIDER_ORDER) ---
# Verify model names and free-tier limits against Cerebras's live catalogue at key setup.
CEREBRAS_API_KEY=your-cerebras-api-key
CEREBRAS_MODEL_FAST=gpt-oss-120b
CEREBRAS_MODEL_STRONG=gpt-oss-120b
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_RPM=30
CEREBRAS_RPD=1000
CEREBRAS_MAX_REQUEST_TOKENS=8000
CEREBRAS_PRICE_IN_PER_MTOK_CENTS=0
CEREBRAS_PRICE_OUT_PER_MTOK_CENTS=0

# --- ai / gemini (not in AI_PROVIDER_ORDER; gateway remains if explicitly listed) ---
# GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_STRONG=gemini-3.5-flash
GEMINI_RPM=5
GEMINI_RPD=20
GEMINI_MAX_REQUEST_TOKENS=8000
GEMINI_TIMEOUT_CLASSIFY_MS=5000
GEMINI_TIMEOUT_GENERATE_MS=20000
GEMINI_TIMEOUT_EDIT_MS=30000
GEMINI_PRICE_IN_PER_MTOK_CENTS=0
GEMINI_PRICE_OUT_PER_MTOK_CENTS=0

# --- observability (D5). Both are optional — the app runs silently without them.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- images (R3 D3) ---
# Server-side only; optional. Without it, Unsplash picks fail cleanly and upload still works.
UNSPLASH_ACCESS_KEY=

# AI safety valves (D7 / D8)
# Set AI_KILL_SWITCH=1 to pause every AI route without a deploy.
AI_KILL_SWITCH=
AI_KILL_SWITCH_REASON=


# --- verification (Adhyay, R3) ---
# A real account on the shared project, used by `npm run verify:loop` to walk the core loop
# against the live database under RLS. The script only ever touches rows it created itself.
VERIFY_EMAIL=
VERIFY_PASSWORD=

# --- payments (Adhyay, R3) ---
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
# You invent this when creating the webhook in the Razorpay dashboard; it is not issued.
RAZORPAY_WEBHOOK_SECRET=replace_me
